# Copy this file to .env and set values for your environment.
#
# Required for all providers:
# - LLM_PROVIDER
# - LLM_MODEL

# -----------------------------
# Core provider settings
# -----------------------------
# Supported: openai, anthropic, google, optusaifoundation
LLM_PROVIDER=openai

# Examples:
# - openai: gpt-4o-mini
# - anthropic: claude-3-5-sonnet-latest
# - google: gemini-1.5-pro
# - optusaifoundation: set your OAIF model id
LLM_MODEL=gpt-4o-mini

# -----------------------------
# Credentials
# -----------------------------
# Required for openai/anthropic/google:
LLM_API_KEY=

# Required for optusaifoundation only:
LLM_CLIENT_ID=
LLM_CLIENT_SECRET=

# Optional for optusaifoundation:
LLM_OAUTH_URL=

# Optional for all providers:
# e.g. custom gateway or proxy base URL
LLM_GATEWAY_URL=

# -----------------------------
# Request/runtime options
# -----------------------------
# true/false (default: false)
LLM_VERIFY_SSL=false

# float, optional
LLM_TEMPERATURE=

# int, optional
LLM_MAX_TOKENS=

# float seconds (default: 60)
LLM_TIMEOUT_SECONDS=60

# true/false (default: false)
LLM_STREAMING=false

# true/false (default: false)
LLM_LOG_FULL_EXCHANGES=false

# Used when response_schema is passed and strict not explicitly provided
# true/false (default: true)
LLM_STRICT_JSON_SCHEMA=true

# Optional name when building json_schema wrappers (default: structured_output)
LLM_RESPONSE_SCHEMA_NAME=structured_output
